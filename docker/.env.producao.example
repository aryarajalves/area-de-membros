# Domínios no Traefik (HTTPS com Let's Encrypt)
FRONTEND_DOMAIN=membros.seudominio.com
API_DOMAIN=api-membros.seudominio.com
SERVER_URL=https://membros.seudominio.com
VITE_API_BASE_URL=https://api-membros.seudominio.com

# Imagens Docker Publicadas no Docker Hub
BACKEND_IMAGE=aryalvesfernandes/area-de-membros:backend-1.0.0
FRONTEND_IMAGE=aryalvesfernandes/area-de-membros:frontend-1.0.0

# Banco de Dados PostgreSQL (Instância já existente no servidor/Swarm)
