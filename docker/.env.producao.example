# Armazenamento em Nuvem / Backups (Backblaze B2 / S3)
BACKBLAZE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_KEY_ID=seu-key-id
BACKBLAZE_APPLICATION_KEY=sua-application-key
BACKBLAZE_BUCKET_NAME=area-de-membros-producao
BACKBLAZE_CDN_URL=https://s3.us-west-004.backblazeb2.com/area-de-membros-producao
B2_FOLDER=areademembros/backups/
B2_RETENTION_MAX=30

# Worker de Verificações Periódicas (Rotinas Diárias e Backups em Background)
WORKER_RENEWAL_CHECK_INTERVAL_HOURS=24
