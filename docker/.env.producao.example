# ==============================================================================
# Variáveis de Ambiente para a Stack de Produção (Docker Swarm + Traefik)
# ==============================================================================
# Copie este arquivo para .env no mesmo diretório ou passe na stack do Swarm
# ==============================================================================

# Domínios no Traefik (HTTPS com Let's Encrypt)
FRONTEND_DOMAIN=membros.seudominio.com
API_DOMAIN=api-membros.seudominio.com
SERVER_URL=https://membros.seudominio.com
VITE_API_BASE_URL=https://api-membros.seudominio.com

# Imagens Docker Publicadas no Docker Hub
BACKEND_IMAGE=aryalvesfernandes/area-de-membros:backend-1.0.1
FRONTEND_IMAGE=aryalvesfernandes/area-de-membros:frontend-1.0.1

# Banco de Dados PostgreSQL (String de Conexão Única)
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@postgres:5432/area_de_membros

# Autenticação e Segurança (JWT e Pepper)
SECRET_KEY=sua_chave_secreta_jwt_de_64_chars_aqui
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURITY_PASSWORD_PEPPER=seu_pepper_secreto_de_64_chars_aqui

# Credenciais Iniciais do Super Administrador
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@seudominio.com
SUPERADMIN_PASSWORD=SuaSenhaForteAqui123!

# Envio de E-mails Transacionais (Brevo API)
BREVO_API_KEY=xkeysib-sua-chave-aqui
BREVO_SENDER_EMAIL=suporte@seudominio.com
BREVO_SENDER_NAME=Área de Membros

# Armazenamento em Nuvem / Backups (Backblaze B2 / S3)
BACKBLAZE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_KEY_ID=seu-key-id
BACKBLAZE_APPLICATION_KEY=sua-application-key
BACKBLAZE_BUCKET_NAME=area-de-membros-producao
BACKBLAZE_CDN_URL=https://s3.us-west-004.backblazeb2.com/area-de-membros-producao
B2_FOLDER=areademembros/backups/
B2_RETENTION_MAX=30

# Worker de Verificações Periódicas (Rotinas Diárias e Backups em Background)
WORKER_RENEWAL_CHECK_INTERVAL_HOURS=24

# [OPCIONAL / NECESSÁRIO PARA IA] OpenAI API (Transcrição de Aulas com Whisper e Resumo Inteligente com GPT-4o)
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
