# Exemplo de variáveis de ambiente do Backend
PROJECT_NAME="Área de Membros"
API_V1_STR="/api/v1"

# Banco de Dados
DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/projetobase"

# [OPCIONAL] Configurações de Conexão e Pool do Banco de Dados (PostgreSQL)
# Quantidade de conexões permanentes no pool base otimizada para escala (padrão: 30)
DB_POOL_SIZE=30
# Quantidade máxima de conexões extras permitidas em picos (padrão: 50)
DB_MAX_OVERFLOW=50
# Tempo máximo em segundos de espera por uma conexão livre antes de timeout (padrão: 20)
DB_POOL_TIMEOUT=20
# Intervalo em segundos para reciclar conexões inativas (padrão: 1800 - 30 min)
DB_POOL_RECYCLE=1800

# Segurança JWT
SECRET_KEY="supersecret-jwt-key-area-de-membros-981273491"
# [OPCIONAL] Tempo de validade do token JWT em minutos (padrão no código: 10080 = 7 dias / 1 semana)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Credenciais Iniciais do Super Admin
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="aryarajmarketing@gmail.com"
SUPERADMIN_PASSWORD="SuperAdmin@2026!"

# Pepper do Sistema (Argon2id + HMAC-SHA256 - Chave Secreta do Servidor)
SECURITY_PASSWORD_PEPPER="d6e3f89a2b5c4701e1c9d8a4f3b207e691238475a1092837465bcdf012938475"

# Brevo (Envio de E-mail via API REST)
BREVO_API_KEY="xkeysib-seu-api-key-aqui"
BREVO_SENDER_EMAIL="remetente-validado@seudominio.com"
BREVO_SENDER_NAME="Área de Membros"
# [OPCIONAL] URL pública do frontend usada para gerar links de confirmação nos e-mails (se vazia, detecta automaticamente pela requisição)
FRONTEND_URL="https://comunidade.seudominio.com"

# [OPCIONAL / RECOMENDADO] Armazenamento de Backups em Nuvem (Backblaze B2 / AWS S3)
# O sistema aceita tanto BACKBLAZE_* quanto B2_*
BACKBLAZE_ENDPOINT_URL="https://s3.us-west-004.backblazeb2.com"
BACKBLAZE_KEY_ID="seu-application-key-id"
BACKBLAZE_APPLICATION_KEY="seu-application-key-secreto"
BACKBLAZE_BUCKET_NAME="seu-bucket-de-backup"
B2_ENDPOINT_URL="https://s3.us-west-004.backblazeb2.com"
B2_KEY_ID="seu-application-key-id"
B2_APPLICATION_KEY="seu-application-key-secreto"
B2_BUCKET_NAME="seu-bucket-de-backup"
BACKBLAZE_CDN_URL="https://s3.us-west-004.backblazeb2.com/seu-bucket-de-backup"
B2_FOLDER="projetobase/backups/"
# Limite máximo de retenção de dumps no S3 antes de expurgar o mais antigo
B2_RETENTION_MAX=30

# [OPCIONAL] Configurações do Worker de Verificações Periódicas
# Habilita o scheduler interno dentro do processo web (deve ser false se estiver usando o container 'worker' separado)
ENABLE_INTERNAL_SCHEDULER=false
# Intervalo em horas para a rotina periódica de verificação de renovação/expiração de cursos (padrão: 24)
WORKER_RENEWAL_CHECK_INTERVAL_HOURS=24
# [OPCIONAL / NECESSÁRIO PARA IA] OpenAI API (Transcrição de Aulas com Whisper e Resumo Inteligente com GPT-4o)
OPENAI_API_KEY="sk-proj-sua-chave-openai-aqui"
# [OPCIONAL] Taxa de Câmbio USD -> BRL para estimativa de custo em reais de IA (Whisper + GPT-4o-mini, padrão: 5.50)
OPENAI_USD_BRL_RATE=5.50

# [OPCIONAL / INTEGRAÇÃO AGENTFLOW] Conexão com AgentFlow para sincronização de Base de Conhecimento RAG
AGENTFLOW_API_URL="https://backendagente.aryaraj.shop"
AGENTFLOW_API_KEY="ag_live_sua_chave_agentflow_aqui"

# [OPCIONAL / RECOMENDADO] Chave Mestra de Criptografia Simétrica para Mensagens Diretas (DMs) no Banco de Dados
# Chave URL-safe base64 de 32 bytes (Fernet / AES-128-CBC). Se omitida, deriva automaticamente uma chave segura a partir de SECRET_KEY.
DM_ENCRYPTION_KEY="k8sJ19vKxM1-uKzLqQ-8rV4_wA0xYz1234567890abc="


# [OPCIONAL / ESCALABILIDADE] Conexão com Redis para Pub/Sub de WebSockets e Presença Distribuída em Múltiplos Workers
# Em produção: redis://redis:6379/0 ou com senha: redis://:senha@redis:6379/0. Se vazio, opera em modo in-memory.
REDIS_URL="redis://redis:6379/0"

# [OPCIONAL] Quantidade de workers paralelos Uvicorn por container (padrão: 1; aumente conforme vCPUs e RAM da réplica)
WORKERS=1

# [OPCIONAL / ALTA ESCALA] CDN de Vídeos com Cache de Streaming no Edge (Cloudflare / Bunny / Fastly na frente do Backblaze B2/S3)
# Se preenchido, os players de vídeo dos alunos puxam os vídeos do cache da CDN em vez de sobrecarregar o bucket de origem.
# Para evitar bloqueios de firewalls corporativos em subdomínios externos, você pode definir "/cdn-videos" (ou "https://seudominio.com/cdn-videos"),
# que entrega os vídeos no mesmo domínio principal via Nginx + Cloudflare com suporte a Byte-Range e cache no Edge.
VIDEO_CDN_URL="https://cdn-videos.suaplataforma.com"
STREAMING_CACHE_ENABLED=true

# [OPCIONAL / ESCALABILIDADE IA] Ativa busca vetorial nativa indexada no PostgreSQL via pgvector (HNSW)
PGVECTOR_ENABLED=true

# [OPCIONAL] Origens permitidas para requisições CORS separadas por vírgula (ex: http://localhost:3010,https://suaplataforma.com)
# Padrão: * (permite todas as origens em desenvolvimento)
CORS_ORIGINS="*"

# [OPCIONAL / PUSH NATIVO] Credenciais do Firebase Admin SDK para envio de Push Notifications via FCM (Android/iOS)
# Informe o conteúdo JSON da conta de serviço do Firebase (inline) OU o caminho para o arquivo .json no container
FIREBASE_CREDENTIALS_JSON=""
FIREBASE_CREDENTIALS_PATH=""

# [OPCIONAL / MONITORAMENTO] Chaves DSN do Sentry para rastreamento de erros em produção (Backend, Worker e Frontend via Túnel)
# Deixe vazio para manter o monitoramento desativado em ambiente local
SENTRY_DSN_BACKEND=""
SENTRY_DSN_FRONTEND=""
# Ambiente reportado no painel do Sentry (production, staging, development)
SENTRY_ENVIRONMENT="production"
# Taxa de amostragem de transações de performance (0.0 a 1.0 - padrão 0.2 = 20%)
SENTRY_TRACES_SAMPLE_RATE=0.2
# Taxa de gravação de Session Replay em sessões normais (0.0 a 1.0 - padrão 0.05 = 5%)
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
# Taxa de gravação de Session Replay quando ocorre um erro (0.0 a 1.0 - padrão 1.0 = 100%)
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
